#!/bin/sh
# Generated by netlab: stateful firewall for {{ name }}.
set -eu
ip addr add {{ fw.inside.address }} dev {{ fw.inside.interface }} 2>/dev/null || true
ip addr add {{ fw.outside.address }} dev {{ fw.outside.interface }} 2>/dev/null || true
ip route replace default via {{ fw.outside.gateway }}
sysctl -qw net.ipv4.ip_forward=1 || true  # also set by the topology

iptables -F FORWARD
iptables -P FORWARD DROP
{% for rule in fw.rules %}
# {{ rule.name }}
iptables -A FORWARD{% if rule.state is defined %} -m conntrack --ctstate {{ rule.state | join(',') }}{% endif %}{% if rule.proto is defined %} -p {{ rule.proto }}{% endif %}{% if rule.src is defined %} -s {{ rule.src }}{% endif %}{% if rule.dst is defined %} -d {{ rule.dst }}{% endif %}{% if rule.dport is defined %} --dport {{ rule.dport }}{% endif %} -j {{ rule.action | upper }} -m comment --comment "{{ rule.name }}"
{% endfor %}
iptables -A FORWARD -j LOG --log-prefix "fw-drop: " -m comment --comment default-drop
