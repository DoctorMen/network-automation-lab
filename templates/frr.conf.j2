! Generated by netlab from inventory/network.yml. Do not edit by hand.
frr defaults traditional
hostname {{ name }}
log stdout informational
service integrated-vtysh-config
!
interface lo
 ip address {{ router.loopback }}
{% if router.ospf is defined %} ip ospf area {{ router.ospf.area }}
{% endif %}exit
!
{% for local, remote in neighbors %}
interface {{ local.interface }}
 description to-{{ remote.device }}:{{ remote.interface }}
 ip address {{ local.address }}
{% if router.ospf is defined and remote.device in ospf_peers %} ip ospf area {{ router.ospf.area }}
 ip ospf network point-to-point
 ip ospf bfd
{% elif router.ospf is defined and remote.device in passive_lans %} ip ospf area {{ router.ospf.area }}
 ip ospf passive
{% endif %}exit
!
{% endfor %}
{% for route in router.static_routes | default([]) %}
ip route {{ route.prefix }} {{ route.next_hop }}
{% endfor %}
{% if router.ospf is defined %}
router ospf
 ospf router-id {{ router_id }}
{% if router.static_routes | default([]) | selectattr('redistribute') | list %} redistribute static
{% endif %}{% if router.ospf.default_originate | default(false) %} default-information originate always
{% endif %}exit
!
{% endif %}
{% if router.bgp is defined %}
router bgp {{ local_as }}
 bgp router-id {{ router_id }}
 no bgp ebgp-requires-policy
{% for n in bgp_neighbors %} neighbor {{ n.address }} remote-as {{ n.remote_as }}
 neighbor {{ n.address }} description {{ n.peer }}
{% endfor %} !
 address-family ipv4 unicast
{% for net in router.bgp.networks | default([]) %}  network {{ net }}
{% endfor %}{% if router.bgp.aggregate is defined %}  aggregate-address {{ router.bgp.aggregate }} summary-only
  redistribute ospf
{% endif %} exit-address-family
exit
!
{% endif %}
{% if router.role == 'isp' %}
! Stand-in for "the internet": a /24 the ISP originates.
ip route 203.0.113.0/24 Null0
{% endif %}
