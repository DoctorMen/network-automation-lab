#!/bin/sh
# Generated by netlab: {{ name }}, LAN-A's access switch (decision 0032). A Linux bridge over its ports, each an
# access port in its VLAN, with broadcast storm control per edge port (decision 0034).
set -eu
# VLAN filtering makes the bridge keep a MAC table per VLAN, which `netlab where` reads. A kernel built without
# it (the sandbox this lab was built in: RTNETLINK answers "Not supported", V-033) gets a plain bridge instead,
# and says so in /run/switch.state; the live tests read that file and skip what they then can't prove.
if ip link add {{ bridge }} type bridge vlan_filtering 1 2>/dev/null; then
  filtering=on
else
  ip link add {{ bridge }} type bridge
  filtering=unsupported
fi
echo "vlan_filtering: $filtering" > /run/switch.state
{% for port, p in ports.items() %}
# {{ port }}: {{ p.role }}{% if p.to %} to {{ p.to }}{% endif %}, VLAN {{ p.vlan }}
ip link set {{ port }} master {{ bridge }}
if [ "$filtering" = on ]; then
  # An access port: untagged frames in belong to its VLAN (pvid), frames out leave untagged. The default VLAN 1 goes.
  bridge vlan add dev {{ port }} vid {{ p.vlan }} pvid untagged
  bridge vlan del dev {{ port }} vid 1
fi
{% endfor %}
ip link set {{ bridge }} up
{% if storm %}
# Storm control (decision 0034): on each edge port, broadcast frames above {{ storm.broadcast_pps }} a second are dropped
# where they come in (nat PREROUTING runs once per ingress frame; FORWARD would run once per flooded copy, so one
# token bucket would be shared by every other port). Unicast and the port itself are untouched: the port stays up.
# `make release PORT={{ name }}:<port>` takes a port's two rules out again; `make contain` puts them back.
ebtables -t nat -F PREROUTING
{% for port, p in ports.items() if p.role == "edge" %}
ebtables -t nat -A PREROUTING -i {{ port }} -d ff:ff:ff:ff:ff:ff --limit {{ storm.broadcast_pps }}/sec --limit-burst {{ storm.broadcast_pps }} -j ACCEPT
ebtables -t nat -A PREROUTING -i {{ port }} -d ff:ff:ff:ff:ff:ff -j DROP
{% endfor %}
{% endif %}
