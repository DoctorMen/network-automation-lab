# Generated by netlab from inventory/network.yml. Do not edit by hand.
# The collector (decision 0019). Every syslog source's lines arrive on UDP {{ ports.syslog }}, each app forwarder's on
# TCP {{ ports.forward }}. Each line goes to Loki as it was sent, labelled with its node and source, and sets that
# source's last-seen time, which Prometheus reads for the SourceSilent check. The NOC's mailbox reports each
# mail that reaches it on {{ ports.mail_hook }}, which sets the mail path's last-seen time (decision 0022).
data_dir: /var/lib/vector
sources:
  syslog:
    # A plain socket, not Vector's syslog parser: busybox sends no hostname, and the parser would take
    # the program name for one. The line is kept exactly as the device sent it.
    type: socket
    mode: udp
    address: 0.0.0.0:{{ ports.syslog }}
  forwarders:
    type: vector
    address: 0.0.0.0:{{ ports.forward }}
  mailbox:
    # Mailpit's webhook: one POST, a JSON summary, per mail it receives. On 127.0.0.1 only.
    type: http_server
    address: 127.0.0.1:{{ ports.mail_hook }}
    decoding: { codec: json }
transforms:
  syslog_node:
    type: remap
    inputs: [syslog]
    source: |
      # Every address each source can send from (a router's follows its egress interface).
      nodes = {{ addresses | tojson }}
      .node = get(nodes, [.host]) ?? "unknown"
      .source = "syslog"
      .message = strip_whitespace(string!(.message))
  mail_node:
    type: remap
    inputs: [mailbox]
    source: |
      .node = "{{ inv.monitoring.host }}"
      .source = "mail"
      .message = string(.Subject) ?? "mail"
  seen:
    type: remap
    inputs: [syslog_node, forwarders, mail_node]
    source: |
      .seen = to_unix_timestamp(now())
  last_seen:
    type: log_to_metric
    inputs: [seen]
    metrics:
      - type: gauge
        field: seen
        name: log_last_seen_seconds
        tags: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
      - type: counter
        field: message
        name: log_lines_total
        tags: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
sinks:
  loki:
    type: loki
    inputs: [syslog_node, forwarders]
    endpoint: http://127.0.0.1:{{ ports.loki }}
    # Loki starts with the lab too; until it answers, Vector retries instead of failing its healthcheck.
    healthcheck: { enabled: false }
    encoding: { codec: text }
    labels: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
  metrics:
    type: prometheus_exporter
    inputs: [last_seen]
    address: 127.0.0.1:{{ ports.collector_metrics }}
    # Prometheus stamps each sample with its own scrape time, so a silent source's age keeps growing,
    # and a source's series is kept between its lines (the default would drop it after 60 s).
    suppress_timestamp: true
    flush_period_secs: 86400
