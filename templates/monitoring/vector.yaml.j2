# Generated by netlab from inventory/network.yml. Do not edit by hand.
# The collector (decision 0019). Every syslog source's lines arrive on UDP {{ ports.syslog }}, each app forwarder's on
# TCP {{ ports.forward }}. Each line goes to Loki as it was sent, labelled with its node and source, and sets that
# source's last-seen time, which Prometheus reads for the SourceSilent check. The NOC's mailbox reports each
# mail that reaches it on {{ ports.mail_hook }}, which sets the mail path's last-seen time (decision 0022).
data_dir: /var/lib/vector
sources:
  syslog:
    # A plain socket, not Vector's syslog parser: busybox sends no hostname, and the parser would take
    # the program name for one. The line is kept exactly as the device sent it.
    type: socket
    mode: udp
    address: 0.0.0.0:{{ ports.syslog }}
    # The port each line was sent from: a router's command records and its translation log come from their
    # own ports below 1024, which only root on that router can send from (decisions 0029 and 0031).
    port_key: port
  forwarders:
    type: vector
    address: 0.0.0.0:{{ ports.forward }}
  mailbox:
    # Mailpit's webhook: one POST, a JSON summary, per mail it receives. On 127.0.0.1 only.
    type: http_server
    address: 127.0.0.1:{{ ports.mail_hook }}
    decoding: { codec: json }
transforms:
  syslog_node:
    type: remap
    inputs: [syslog]
    source: |
      # Every address each source can send from (a router's follows its egress interface).
      nodes = {{ addresses | tojson }}
      .node = get(nodes, [.host]) ?? "unknown"
      .source = "syslog"
      # A line from a router's own low port is that router's command record or translation log, each a source of
      # its own; the same text sent from any other port, by any other account, stays syslog (decision 0029).
      sent_from = to_string(.port) ?? ""
{% for port, s in senders.items() %}
      if sent_from == "{{ port }}" && includes({{ s.nodes | tojson }}, .node) {
        .source = "{{ s.source }}"
      }
{% endfor %}
      del(.port)
      .message = strip_whitespace(string!(.message))
  mail_node:
    type: remap
    inputs: [mailbox]
    source: |
      .node = "{{ inv.monitoring.host }}"
      .source = "mail"
      .message = string(.Subject) ?? "mail"
  seen:
    type: remap
    inputs: [syslog_node, forwarders, mail_node]
    source: |
      .seen = to_unix_timestamp(now())
      # Each line's size in bytes as it goes to the store: the ingest each source's budget is held to (decision
      # 0026). VRL's length() counts a string's bytes; strlen() would count its characters.
      .bytes = length(string!(.message))
  # A record from a router's accounting proxy (decision 0029): an account opened FRR's CLI, was refused or ran a
  # command. Its arrival time per node and account is what UnexpectedAdmin reads; the line itself goes to Loki
  # under its own source. A line that only looks like one (sent any other way) is not counted.
  accounting:
    type: remap
    inputs: [syslog_node]
    drop_on_abort: true
    source: |
      if .source != "{{ accounting_source }}" { abort }
      parsed, err = parse_regex(.message, r'^<\d+>\w{3} [ \d]\d [\d:]{8} vty-aaa\[\d+\]: (?P<event>accept|refuse|command) user=(?P<user>\S+) ')
      if err != null { abort }
      .event = parsed.event
      .user = parsed.user
      .seen = to_unix_timestamp(now())
  admin_seen:
    type: log_to_metric
    inputs: [accounting]
    metrics:
      - type: gauge
        field: seen
        name: admin_last_seen_seconds
        tags: { node: "{% raw %}{{ node }}{% endraw %}", user: "{% raw %}{{ user }}{% endraw %}", event: "{% raw %}{{ event }}{% endraw %}" }
  last_seen:
    type: log_to_metric
    inputs: [seen]
    metrics:
      - type: gauge
        field: seen
        name: log_last_seen_seconds
        tags: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
      - type: counter
        field: message
        name: log_lines_total
        tags: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
      - type: counter
        field: bytes
        increment_by_value: true
        name: log_bytes_total
        tags: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
sinks:
  loki:
    type: loki
    inputs: [syslog_node, forwarders]
    endpoint: http://127.0.0.1:{{ ports.loki }}
    # Loki starts with the lab too; until it answers, Vector retries instead of failing its healthcheck.
    healthcheck: { enabled: false }
    encoding: { codec: text }
    labels: { node: "{% raw %}{{ node }}{% endraw %}", source: "{% raw %}{{ source }}{% endraw %}" }
  metrics:
    type: prometheus_exporter
    inputs: [last_seen, admin_seen]
    address: 127.0.0.1:{{ ports.collector_metrics }}
    # Prometheus stamps each sample with its own scrape time, so a silent source's age keeps growing,
    # and a source's series is kept between its lines (the default would drop it after 60 s).
    suppress_timestamp: true
    flush_period_secs: 86400
