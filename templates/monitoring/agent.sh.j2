#!/bin/sh
# Generated by netlab from inventory/network.yml. Do not edit by hand.
# What each node the NOC watches runs beside its own job (decisions 0018 and 0019), started once by its
# exec step. It changes nothing the node does: it logs, and it reports.
set -eu
# Every syslog line goes to the collector as it is written (-R), and a small rotated copy stays on the box
# (-L, {{ logs.on_box.size_kb }} KB plus {{ logs.on_box.rotated }} rotated file). busybox syslogd sends over UDP and never knows whether a line arrived.
syslogd -R {{ collector }}:{{ ports.syslog }} -L -s {{ logs.on_box.size_kb }} -b {{ logs.on_box.rotated }}
# The heartbeat sets this source's normal gap: the collector expects a line at least every {{ logs.heartbeat }} s.
(while :; do logger -t heartbeat alive; sleep {{ logs.heartbeat }}; done) </dev/null >/dev/null 2>&1 &
# Routers we own: the pending-reboot metric for node_exporter's textfile collector, by the same kernel
# rule as `make verify` (netlab/kernel.py). Written aside and renamed, so a scrape never reads half a file.
if [ -d /textfile ]; then
  (while :; do python3 /monitoring/kernel.py > /textfile/kernel.prom.tmp && mv /textfile/kernel.prom.tmp /textfile/kernel.prom; sleep {{ textfile_every }}; done) </dev/null >/dev/null 2>&1 &
fi
