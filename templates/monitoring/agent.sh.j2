#!/bin/sh
# Generated by netlab from inventory/network.yml. Do not edit by hand.
# What each node the NOC watches runs beside its own job (decisions 0018, 0019 and 0025), started once by its
# exec step. It changes nothing the node does: it logs, it reports, and it records.
#   sh /monitoring/agent.sh            start everything below (the exec step does this once)
#   sh /monitoring/agent.sh dump WHY   print a state dump now and send it to the collector (make evidence)
set -eu

# The flight recorder's state dump (decision 0025): the node's interfaces with their counters, its queues,
# its filters' counters and, on a router, its routing state, each line tagged with the dump's id. Only
# commands that read, and no running config, so no secret can be in it. A line is cut at {{ flightrec.width }}
# characters, because busybox syslogd cuts a longer message anyway.
run() {
  "$@" 2>&1 || echo "($1 failed: $?)"
}
dump() {
  id="fr-$(hostname)-$(date +%s)-$(od -An -N3 -tx1 /dev/urandom | tr -d ' ')"
  raw=/tmp/flightrec.$id
  {
    run ip -br link
    # One line of counters per interface, as `ip -s link` shows them in six.
    for dev in $(ls /sys/class/net); do
      c=/sys/class/net/$dev/statistics
      echo "counters $dev rx_bytes=$(cat $c/rx_bytes) rx_packets=$(cat $c/rx_packets) rx_dropped=$(cat $c/rx_dropped)" \
        "tx_bytes=$(cat $c/tx_bytes) tx_packets=$(cat $c/tx_packets) tx_dropped=$(cat $c/tx_dropped) carrier_changes=$(cat /sys/class/net/$dev/carrier_changes)"
    done
    run tc -s qdisc
    for dev in $(ls /sys/class/net); do run tc -s class show dev "$dev"; done
    run iptables -vnxL
    if pidof zebra >/dev/null; then
      run vtysh -c "show interface brief" -c "show ip ospf neighbor" -c "show bfd peers brief" -c "show ip route"
    fi
  } > "$raw"
  echo "$id begin $1"
  sed "s/^/$id /" "$raw" | cut -c1-{{ flightrec.width }}
  echo "$id end $(wc -l < "$raw") lines"
  rm -f "$raw"
}
if [ "${1:-}" = dump ]; then
  out=/tmp/flightrec.asked.$$
  dump "asked: ${2:-no reason given}" > "$out"
  cat "$out"
  logger -t flightrec < "$out"
  rm -f "$out"
  exit 0
fi

# Every syslog line goes to the collector as it is written (-R), and a small rotated copy stays on the box
# (-L, {{ logs.on_box.size_kb }} KB plus {{ logs.on_box.rotated }} rotated file). busybox syslogd sends over UDP and never knows whether a line arrived.
syslogd -R {{ collector }}:{{ ports.syslog }} -L -s {{ logs.on_box.size_kb }} -b {{ logs.on_box.rotated }}
# The heartbeat sets this source's normal gap: the collector expects a line at least every {{ logs.heartbeat }} s.
(while :; do logger -t heartbeat alive; sleep {{ logs.heartbeat }}; done) </dev/null >/dev/null 2>&1 &
# Routers we own: the pending-reboot metric for node_exporter's textfile collector, by the same kernel
# rule as `make verify` (netlab/kernel.py). Written aside and renamed, so a scrape never reads half a file.
if [ -d /textfile ]; then
  (while :; do python3 /monitoring/kernel.py > /textfile/kernel.prom.tmp && mv /textfile/kernel.prom.tmp /textfile/kernel.prom; sleep {{ textfile_every }}; done) </dev/null >/dev/null 2>&1 &
fi
# The flight recorder, armed for the next fault: when an interface loses its carrier or goes down, it takes
# a dump at once, while the fault is still there, and sends it {{ flightrec.delay }} s later, because the link that went
# down may have been this node's way to the collector. At most one dump every {{ flightrec.every }} s, so a flapping
# link can't flood the collector or push everything else out of the box's own small log. If the watcher stops
# (killed, or `ip` failed), it is started again {{ flightrec.delay }} s later, with a line that says so.
(
  while :; do
    last=0
    ip monitor link | while read -r line; do
      case "$line" in
        *NO-CARRIER*|*"state DOWN"*|*LOWERLAYERDOWN*) ;;
        *) continue ;;
      esac
      now=$(date +%s)
      [ $((now - last)) -ge {{ flightrec.every }} ] || continue
      last=$now
      dev=${line#*: }
      dev=${dev%%[:@]*}
      dump "trigger: $dev lost carrier or went down" > /tmp/flightrec.last
      (sleep {{ flightrec.delay }}; logger -t flightrec < /tmp/flightrec.last) &
    done
    sleep {{ flightrec.delay }}
    logger -t flightrec "ip monitor link had stopped; the flight recorder is armed again"
  done
) </dev/null >/dev/null 2>&1 &
