# Generated by netlab from inventory/network.yml. Do not edit by hand.
# Every alert goes to the NOC's webhook sink (sink.py on noc), one notification per alert, and again
# when it resolves. The sink stands in for the pager: the live tests read what it received. Each page is
# also mailed to the NOC's mailbox (Mailpit on noc), the alert path that Watchdog proves (decision 0022).
route:
  receiver: sink
  # '...' groups by every label, so each object's alert is its own notification.
  group_by: ['...']
  # Held this long before its first page, so a cause seen in the same seconds is there to hold it back
  # (decision 0021). The cause markers are evaluated every second; what they cover fires 10 s or more after.
  group_wait: {{ mon.group_wait }}s
  group_interval: 5s
  repeat_interval: 1h
  routes:
    # A cause marker only holds back what depends on it; the cause's own page is NodeDown, LinkDown or TargetDown.
    - matchers: ['alertname="CauseSeen"']
      receiver: nowhere
    # The alert path's heartbeat: mailed again every {{ mon.alert_path.every }} s, and AlertPathSilent pages over the webhook when
    # the mail stops arriving (NOT-4).
    - matchers: ['alertname="Watchdog"']
      receiver: mail
      group_wait: 0s
      repeat_interval: {{ mon.alert_path.every }}s
# One page per cause (OROS DEC-5, decision 0021). Each alert's deps label lists the causes it can't be seen
# without, from the inventory's graph (netlab/monitoring.py Dependencies). While a cause fires (its marker,
# or its page, which keeps firing for a while after it recovers), every alert that lists it is held back.
inhibit_rules:
{% for c in causes %}
  - source_matchers: ['cause="{{ c }}"']
    target_matchers: ['deps=~".*/{{ c }}/.*"']
{% endfor %}
receivers:
  - name: sink
    webhook_configs:
      - url: http://127.0.0.1:{{ ports.sink }}/
        send_resolved: true
    email_configs:
      - to: noc@netlab.invalid
        from: alertmanager@netlab.invalid
        smarthost: 127.0.0.1:{{ ports.smtp }}
        require_tls: false
  - name: mail
    email_configs:
      - to: noc@netlab.invalid
        from: alertmanager@netlab.invalid
        smarthost: 127.0.0.1:{{ ports.smtp }}
        require_tls: false
  - name: nowhere
