# Generated by netlab from inventory/network.yml. Do not edit by hand.
# Every alert goes to the NOC's webhook sink (sink.py on noc), one notification per alert, and again
# when it resolves. The sink stands in for the pager: the live tests read what it received.
route:
  receiver: sink
  # '...' groups by every label, so each object's alert is its own notification.
  group_by: ['...']
  group_wait: 1s
  group_interval: 5s
  repeat_interval: 1h
receivers:
  - name: sink
    webhook_configs:
      - url: http://127.0.0.1:{{ ports.sink }}/
        send_resolved: true
