# Generated by netlab from inventory/network.yml. Do not edit by hand.
# The central log store (decision 0019): one Loki, on its own disk, listening only inside noc. Lines
# arrive from the collector (vector.yaml); each stream is labelled with its node and source.
auth_enabled: false
server:
  http_listen_address: 127.0.0.1
  http_listen_port: {{ ports.loki }}
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 9096
  log_level: warn
common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
# The write-ahead log under /loki/wal replays what was not yet flushed after a crash (decision 0025). A replay
# starts each stream's count of lines again, so the lines taken in after it survive the next crash only once a
# checkpoint has been written since (V-027). Loki's default is a checkpoint every 5 minutes, written over 4.5 of
# them; every 30 s narrows that window to about a minute after each restart.
ingester:
  wal:
    checkpoint_duration: 30s
# History is kept here, not on the boxes: each node keeps {{ logs.on_box.size_kb }} KB plus {{ logs.on_box.rotated }} rotated file.
limits_config:
  retention_period: {{ logs.retention }}h
  # Streams keep only the collector's labels (node, source), not a service_name Loki would guess.
  discover_service_name: []
compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
# No usage reports to Grafana Labs (the lab has no way out anyway).
analytics:
  reporting_enabled: false
