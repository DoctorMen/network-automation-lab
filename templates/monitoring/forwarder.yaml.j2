# Generated by netlab from inventory/network.yml. Do not edit by hand.
# {{ app.host }}'s {{ app.name }} log, forwarded to the collector as the app writes it (decision 0019). This
# runs as nobody (uid 65534) in a sidecar, reading the file read-only; the app itself is unchanged.
data_dir: /tmp
sources:
  app:
    type: file
    include: [/applog/{{ app.name }}-{{ app.port }}.log]
    read_from: end
    # Known by its inode, so an empty file is followed from its first line on (the default fingerprint
    # waits for a first line, and reading from the end would then skip it).
    fingerprint: { strategy: device_and_inode }
transforms:
  label:
    type: remap
    inputs: [app]
    source: |
      .node = "{{ app.host }}"
      .source = "{{ app.name }}"
sinks:
  collector:
    type: vector
    inputs: [label]
    address: {{ collector }}:{{ ports.forward }}
    healthcheck: { enabled: false }
