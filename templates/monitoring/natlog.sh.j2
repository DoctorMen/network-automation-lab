#!/bin/sh
# Generated by netlab from inventory/network.yml. Do not edit by hand.
# {{ name }}'s translation log (OROS FND-5, decision 0031), run by the {{ name }}-nat-log sidecar in {{ name }}'s
# network namespace. conntrack prints each new connection translated to {{ address }} as the kernel
# reports it, stamped with the time it read the event, and each line goes to the collector as one syslog
# datagram tagged {{ tag }}, over UDP like the rest of {{ name }}'s syslog. It is sent from UDP port {{ own_port }}: below
# 1024, which only root in {{ name }}'s namespace can send from, and the collector files only what comes from that
# port as this log, so a line an account on {{ name }} forges stays syslog (decision 0029). A heartbeat line every
# {{ heartbeat }} s shares the pipe and stops with conntrack, so a log that dies pages as SourceSilent for this source.
set -eu
# The sidecar can start before {{ name }}'s links are up, and a send without a route to the collector fails.
until ip route get {{ collector }} >/dev/null 2>&1; do sleep 1; done
SEND='
import socket, sys, time
out = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
out.bind(("", {{ own_port }}))
for line in sys.stdin:
    stamp = time.strftime("%b %e %H:%M:%S")
    try:
        out.sendto(("<14>" + stamp + " {{ tag }}: " + line.rstrip()).encode(), ("{{ collector }}", {{ port }}))
    except OSError:
        pass  # no route this moment: the line is lost, as busybox syslogd would lose it (RISK-63)
'
{
  (while :; do echo heartbeat alive; sleep {{ heartbeat }}; done) &
  conntrack -E -e NEW --src-nat {{ address }} -o timestamp,extended
  kill $!
} 2>&1 | python3 -u -c "$SEND"
