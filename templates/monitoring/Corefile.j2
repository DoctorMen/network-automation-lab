# Generated by netlab from inventory/network.yml (decision 0032). Do not edit by hand.
# The lab's names, from the inventory, on the NOC's address (UDP and TCP 53). The root zone, so the file's reverse
# (PTR) records answer too. A name the file lacks falls through to an empty root zone (root.db, an SOA and nothing
# else), which answers NXDOMAIN, where the hosts plugin alone says SERVFAIL (V-034). No forwarder: nothing here can
# send a lab query to the internet.
.:53 {
    # The NOC's own address only: with no bind, or bind 0.0.0.0, Go opens one dual-stack :::53 socket, which the
    # NOC's listener check refuses (it was CI's finding on 0.0.0.0).
    bind {{ address }}
    hosts /hosts.lab {
        ttl 60
        reload 5s
        fallthrough
    }
    file /root.db
    errors
}
