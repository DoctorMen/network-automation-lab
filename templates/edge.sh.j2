#!/bin/sh
# Generated by netlab: what {{ name }} enforces at its edges, beyond routing (decision 0012).
# Run once by the topology's exec step and mounted read-only; `make drift` compares its iptables lines.
set -eu
{% if rp_filter %}

# Strict reverse-path filter on each interface toward a host LAN: a packet whose source address isn't
# routed back out of the interface it came in on is dropped, so a host can't send as anyone else's
# subnet (RFC 3704). The kernel applies the higher of conf.all and conf.<interface>, so conf.all is
# pinned to 0 here, or a host default of 2 (loose) would quietly win.
sysctl -qw net.ipv4.conf.all.rp_filter=0
{% for ifname in rp_filter %}
sysctl -qw net.ipv4.conf.{{ ifname }}.rp_filter=1
{% endfor %}
{% endif %}
{% if wan %}

# Internet edge on {{ wan.interface }}. Only what arrives there is filtered; the campus links are not.
# Raw table first: it runs before conntrack and routing, so a private source address from the
# internet is dropped whatever it is sent to (BCP 38, RFC 2827).
iptables -t raw -F PREROUTING
{% for net in wan.bogons %}
iptables -t raw -A PREROUTING -i {{ wan.interface }} -s {{ net }} -j DROP -m comment --comment "bogon {{ net }}"
{% endfor %}

# To the router itself: replies to what it started, ping (so the carrier can test the link) and BGP
# from the peer's address to ours. Nothing else, so no management port answers from the internet.
iptables -F INPUT
iptables -A INPUT -i {{ wan.interface }} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT -m comment --comment "wan-established"
iptables -A INPUT -i {{ wan.interface }} -p icmp -j ACCEPT -m comment --comment "wan-icmp"
{% for s in wan.bgp %}
iptables -A INPUT -i {{ wan.interface }} -p tcp -s {{ s.peer }} -d {{ s.local }} --dport 179 -j ACCEPT -m comment --comment "bgp {{ s.peer }}"
{% endfor %}
iptables -A INPUT -i {{ wan.interface }} -j DROP -m comment --comment "wan-drop-local"

# Through the router: replies to connections the campus opened, and new connections to each
# published port. A published rule matches only a connection's opening SYN, like fw1's allow-web.
iptables -F FORWARD
iptables -A FORWARD -i {{ wan.interface }} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT -m comment --comment "wan-established"
{% for p in wan.published %}
iptables -A FORWARD -i {{ wan.interface }} -p tcp --syn -d {{ p.address }} --dport {{ p.port }} -j ACCEPT -m comment --comment "publish {{ p.host }}:{{ p.port }}"
{% endfor %}
iptables -A FORWARD -i {{ wan.interface }} -j DROP -m comment --comment "wan-drop"
{% endif %}
{% if nat %}

# Source NAT for {{ nat.inside | join(', ') }} only (decision 0031): a connection it opens out of
# {{ nat.interface }} leaves from {{ nat.address }}, the address the carrier assigned and routes to us.
# Everything else, the servers and {{ name }}'s own BGP session among them, keeps its address. The nat table
# sees only the first packet of each connection; conntrack translates the rest, and the replies, and
# logs each new translation to the NOC (templates/monitoring/natlog.sh.j2).
iptables -t nat -F POSTROUTING
{% for net in nat.inside %}
iptables -t nat -A POSTROUTING -o {{ nat.interface }} -s {{ net }} -j SNAT --to-source {{ nat.address }} -m comment --comment "nat {{ net }}"
{% endfor %}
{% endif %}
