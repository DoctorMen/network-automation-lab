# Generated by netlab from inventory/network.yml. Do not edit by hand.
name: {{ inv.lab_name }}

topology:
  defaults:
    image: {{ image }}
  nodes:
{% for name in inv.routers %}
    {{ name }}:
      kind: linux
      sysctls:
        net.ipv4.ip_forward: 1
      binds:
        - {{ name }}/frr.conf:/etc/frr/frr.conf
        - {{ name }}/daemons:/etc/frr/daemons
        - vtysh.conf:/etc/frr/vtysh.conf
{% endfor %}
{% for name in inv.firewalls %}
    {{ name }}:
      kind: linux
      entrypoint: sh
      cmd: -c "sleep infinity"
      sysctls:
        net.ipv4.ip_forward: 1
      binds:
        - {{ name }}/firewall.sh:/firewall.sh
      exec:
        - sh /firewall.sh
{% endfor %}
{% for name, h in inv.hosts.items() %}
    {{ name }}:
      kind: linux
      entrypoint: sh
      # Listeners bind to 0.0.0.0, so they can start before the lab links exist.
      cmd: -c "{% for port in h.services | default([]) %}python3 -m http.server {{ port }} >/dev/null 2>&1 & {% endfor %}sleep infinity"
      exec:
        - ip addr add {{ h.address }} dev {{ h.interface }}
        - ip route replace default via {{ h.gateway }}
{% endfor %}
  links:
{% for link in inv.links %}
    - endpoints: ["{{ link.a.device }}:{{ link.a.interface }}", "{{ link.b.device }}:{{ link.b.interface }}"]
{% endfor %}
