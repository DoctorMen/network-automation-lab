# Generated by netlab from inventory/network.yml. Do not edit by hand.
name: {{ inv.lab_name }}

topology:
  defaults:
    image: {{ image }}
    # No management interface. Otherwise Docker's eth0 default route (admin distance 0)
    # beats the OSPF default and traffic leaks out of the lab. Nodes are reached with
    # `docker exec`, which needs no network.
    network-mode: none
  nodes:
{% for name in inv.routers %}
    {{ name }}:
      kind: linux
      sysctls:
        net.ipv4.ip_forward: 1
      binds:
        # Read-only: the rendered files are the intent. A writable bind would let a hand change
        # saved with `write memory` (or an edit to daemons) overwrite build/ and slip past the
        # drift check. vtysh.conf is one file shared by every router.
        - {{ name }}/frr.conf:/etc/frr/frr.conf:ro
        - {{ name }}/daemons:/etc/frr/daemons:ro
        - vtysh.conf:/etc/frr/vtysh.conf:ro
{% if name in edge %}
        # What the router enforces at its edges (filters, reverse-path checks): read-only like frr.conf.
        - {{ name }}/edge.sh:/edge.sh:ro
      exec:
        - sh /edge.sh
{% endif %}
{% endfor %}
{% for name in inv.firewalls %}
    {{ name }}:
      kind: linux
      entrypoint: sh
      cmd: -c "sleep infinity"
      sysctls:
        net.ipv4.ip_forward: 1
      binds:
        # Read-only for the same reason as frr.conf: firewall.sh is the firewall's startup
        # config and the drift check's intent, so it must not be editable from the node.
        - {{ name }}/firewall.sh:/firewall.sh:ro
      exec:
        - sh /firewall.sh
{% endfor %}
{% for name, h in inv.hosts.items() %}
    {{ name }}:
      kind: linux
      entrypoint: sh
      # Listeners bind to 0.0.0.0, so they can start before the lab links exist.
      cmd: -c "{% for port in h.services | default([]) %}python3 -m http.server {{ port }} >/dev/null 2>&1 & {% endfor %}sleep infinity"
      exec:
        - ip addr add {{ h.address }} dev {{ h.interface }}
        - ip route replace default via {{ h.gateway }}
{% if name in inv.qos %}
{% set q = inv.qos[name] %}
        # The inventory's qos block (decision 0011): the port capped at the link's rate, with a
        # parent class so the classes can lend each other what they don't use. Quoted, because
        # "1: " would make YAML read the line as a mapping.
{% for c in q.classes if c.default is defined and c.default %}
        - "tc qdisc add dev {{ q.interface }} root handle 1: htb default {{ c.id }}"
{% endfor %}
        - "tc class add dev {{ q.interface }} parent 1: classid 1:1 htb rate {{ q.rate }}"
{% for c in q.classes %}
        - "tc class add dev {{ q.interface }} parent 1:1 classid 1:{{ c.id }} htb rate {{ c.rate }} ceil {{ q.rate }} prio {{ c.prio }}"
{% endfor %}
{% for c in q.classes if c.sport is defined %}
        - "tc filter add dev {{ q.interface }} parent 1: protocol ip prio 1 u32 match ip sport {{ c.sport }} 0xffff flowid 1:{{ c.id }}"
{% endfor %}
{% endif %}
{% endfor %}
  links:
{% for link in inv.links %}
    - endpoints: ["{{ link.a.device }}:{{ link.a.interface }}", "{{ link.b.device }}:{{ link.b.interface }}"]
{% endfor %}
