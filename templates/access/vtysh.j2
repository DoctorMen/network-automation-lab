#!/bin/sh
# Generated by netlab from inventory/network.yml. Do not edit by hand.
# vtysh for a router we own (decision 0029). Every account but root goes through the accounting proxy:
# FRR's own sockets refuse anyone outside frrvty, and nobody is in it. Root keeps FRR's own.
[ "$(id -u)" -eq 0 ] && exec /usr/bin/vtysh "$@"
exec /usr/bin/vtysh --vty_socket {{ sockets }} "$@"
