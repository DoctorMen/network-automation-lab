#!/bin/sh
# Generated by netlab from inventory/network.yml. Do not edit by hand.
# Named accounts and command accounting on a router we own (decision 0029), run once by an exec step just
# before agent.sh starts syslogd. The proxy logs only when someone connects, which is after deploy.
set -eu
grep -q '^{{ group.name }}:' /etc/group || addgroup -g {{ group.gid }} {{ group.name }}
{% for a in accounts %}
# {{ a.kind }}{{ (': ' ~ a.what) if a.what is defined else '' }}
id {{ a.name }} >/dev/null 2>&1 || adduser -D -u {{ a.uid }} -G {{ group.name }} -s /bin/sh {{ a.name }}
{% endfor %}
# frr-reload.py --reload logs to /var/log/frr, and creates it if it is missing, which only root can.
install -d -g {{ group.name }} -m 2775 /var/log/frr
# The CM tool's scratch folders (ansible/). They are its own, so no other account can plant the file a
# rollback loads, which would then run under the CM tool's name.
install -d -o {{ cm }} -g {{ group.name }} -m 0700 /tmp/netlab-bin /tmp/rollback
install -m 0755 /access/vtysh /usr/local/bin/vtysh
python3 /access/vty_aaa.py {{ group.name }} {{ sockets }} {{ to }} {{ record_port }} </dev/null >/dev/null 2>&1 &
