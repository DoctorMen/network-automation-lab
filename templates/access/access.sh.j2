#!/bin/sh
# Generated by netlab from inventory/network.yml. Do not edit by hand.
# Named accounts and command accounting on a router we own (decision 0029), run once by an exec step just
# before agent.sh starts syslogd. The proxy logs only when someone connects, which is after deploy.
set -eu
grep -q '^{{ group.name }}:' /etc/group || addgroup -g {{ group.gid }} {{ group.name }}
{% for a in accounts %}
# {{ a.kind }}{{ (': ' ~ a.what) if a.what is defined else '' }}
id {{ a.name }} >/dev/null 2>&1 || adduser -D -u {{ a.uid }} -G {{ group.name }} -s /bin/sh {{ a.name }}
{% endfor %}
# frr-reload.py --reload logs to /var/log/frr, and creates it if it is missing, which only root can. Sticky, so
# only a file's owner, the folder's owner or root can rename or delete it: an admin can't swap the CM tool's log
# for their own. The folder is the CM tool's: with fs.protected_regular=2 (GitHub's kernel) the kernel refuses
# root's O_CREAT open (frr-reload.py's append) of a file in a sticky, group-writable folder unless the file's
# owner is root or the folder's owner, so in a folder root owned root's reload got Errno 13 (V-032). Owning it
# lets the CM tool also delete or rename anyone's file there and change the folder's mode.
install -d -o {{ cm }} -g {{ group.name }} -m 3775 /var/log/frr
# Its log file too, before anyone reloads: the CM tool's, so it can append after a reload as root, which would
# otherwise create the file root's with a login shell's umask (022) and refuse the CM tool (Errno 13). Root
# writes it too, the admins read it, nobody else can.
# touch keeps what a file there already holds, and the chown and chmod repair one root created.
touch /var/log/frr/frr-reload.log && chown {{ cm }}:{{ group.name }} /var/log/frr/frr-reload.log && chmod 0640 /var/log/frr/frr-reload.log
# The CM tool's scratch folders (ansible/). They are its own, so no other account can plant the file a
# rollback loads, which would then run under the CM tool's name.
install -d -o {{ cm }} -g {{ group.name }} -m 0700 /tmp/netlab-bin /tmp/rollback
install -m 0755 /access/vtysh /usr/local/bin/vtysh
python3 /access/vty_aaa.py {{ group.name }} {{ sockets }} {{ to }} {{ record_port }} </dev/null >/dev/null 2>&1 &
